# UNIR Platform API — Exemplo de Configuração
# Copia para .env e preenche os valores

# Base de dados (SQLite para dev, PostgreSQL para produção)
# SQLite: sqlite:///./unir.db
# PostgreSQL: postgresql://user:password@host:5432/unir
DATABASE_URL=sqlite:///./unir.db

# Chave secreta para JWT — gera uma com: python3 scripts/generate_secret.py
SECRET_KEY=substituir-por-chave-segura

# Debug (true para dev, false para produção)
DEBUG=true

# Origens permitidas para CORS (JSON array)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","https://rafatocantins.github.io","https://unir.pt"]
